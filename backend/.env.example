# Django
DEBUG=True
SECRET_KEY=change-moi-en-production
ALLOWED_HOSTS=*

# Neon (PostgreSQL) — copie la "Connection string" depuis le dashboard Neon
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/qrregister?sslmode=require

# Google OAuth — Google Cloud Console > Credentials > OAuth Client ID (type "Web application")
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Administration plateforme : définir ces valeurs dans Render, jamais dans Git.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-20-characters
